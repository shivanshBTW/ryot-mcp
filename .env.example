# Example: https://ryot.example.com
RYOT_BASE_URL=https://ryot.example.com

# Use one of these depending on how your Ryot instance authenticates GraphQL.
# Many self-hosted apps use a session cookie after login; Ryot may differ by version/config.
RYOT_AUTH_HEADER=
RYOT_COOKIE=

# Optional: override full GraphQL endpoint if your reverse proxy path differs.
# RYOT_GRAPHQL_URL=https://ryot.example.com/backend/graphql
